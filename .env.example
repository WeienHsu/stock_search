# -----------------------------------------------------------------------------
# Stock Intelligence environment template
# Copy this file to `.env` and fill in only the services you use.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Backend for user-scoped app data (watchlist, alerts, notification settings).
# Options:
#   json     - local JSON files under data/users; simple local default.
#   sqlite   - data/users.db; recommended for local use.
#   postgres - PostgreSQL database (e.g. Supabase); for cloud deployments.
STORAGE_BACKEND=sqlite
DATABASE_URL=

# -----------------------------------------------------------------------------
# App secrets / encrypted secrets
# -----------------------------------------------------------------------------
# Required for storing encrypted notification credentials (SMTP / Telegram / LINE).
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable. Changing it makes previously saved encrypted secrets unreadable.
APP_SECRET_KEY=

# -----------------------------------------------------------------------------
# Taiwan market data
# -----------------------------------------------------------------------------
# Optional FinMind token for chip (法人/融資券) data adapters.
# Tokenless access may work but can be throttled.
FINMIND_API_TOKEN=

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# Set to 1 in local smoke tests to record notifications as JSONL instead of
# sending email / Telegram / LINE / inbox messages.
NOTIFICATION_DRY_RUN=0
NOTIFICATION_DRY_RUN_PATH=.cache/dry_run_notifications.jsonl
